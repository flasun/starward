// Cloudflare Workers settings for `npm run build:cloudflare`.
// Nitro merges this into the generated .output/server/wrangler.json and sets
// `main` and `assets` itself, so they don't belong here. Deploy with
// `npm run deploy:cloudflare` or Workers Builds (see README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starward",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  // Serves at starward.<your-subdomain>.workers.dev. For a custom domain, add
  // "routes": [{ "pattern": "your.domain", "custom_domain": true }].
  "workers_dev": true,
  "observability": { "enabled": true },
  // The bot check on leaderboard posts (Cloudflare Turnstile). The site key is public. The secret
  // is a Worker secret, TURNSTILE_SECRET (dashboard, or `npx wrangler secret put`). Until both
  // are set, posts skip the check.
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAFUHp2JXbkMfseph" },
  // The daily trial's leaderboard. Create the tables once with
  // `npx wrangler d1 migrations apply STARWARD_DB --remote` (the deploy script does it).
  // Pull request previews (`wrangler preview`, which Workers Builds runs on other branches) get
  // their own board and no bot check, so trying a branch never touches the real board.
  "previews": {
    "vars": { "TURNSTILE_SITE_KEY": "" },
    "d1_databases": [
      {
        "binding": "STARWARD_DB",
        "database_name": "starward-preview",
        "database_id": "702d661d-4a3c-46cc-a6a5-daab9027b931",
        "migrations_dir": "d1/migrations"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "STARWARD_DB",
      "database_name": "starward",
      "database_id": "3308c47b-48ba-46a7-aa7e-dcb323589ed2",
      "migrations_dir": "d1/migrations"
    }
  ]
}
